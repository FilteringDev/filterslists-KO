{
  "name": "@filteringdev/filterslists-ko",
  "version": "0.0.0",
  "description": "The adblock filters lists for uBO and AdGuard, designed for Korean-language websites",
  "type": "module",
  "workspaces": [
    "builder",
    "filterslists",
    "devops"
  ],
  "scripts": {
    "build": "npm run build -w builder",
    "ci:decideDeploy": "npm run ci:decideDeploy -w devops",
    "ci:deadDomainClean": "npm run ci:deadDomainClean -w devops",
    "lint:aglint": "npm run lint -w filterslists",
    "lint:builder": "npm run lint -w builder",
    "lint:devops": "npm run lint -w devops"
  },
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FilteringDev/filterslists-KO.git"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@adguard/aglint": "4.0.0-beta.5",
    "@filteringdev/filterslists-ko-raw": "link:filterslists"
  }
}